# Copy to infra/backup.env with root ownership and mode 600.
BACKUP_DIR=/home/devuser/radiometers_esp/infra/backups
BACKUP_LOCAL_KEEP=2
BACKUP_MIN_FREE_BYTES=4294967296
RCLONE_CONFIG=/home/devuser/radiometers_esp/infra/backup-secrets/rclone.conf
# After setting root_folder_id to the application's backup folder:
BACKUP_RCLONE_REMOTE=radiometer-gdrive:
BACKUP_TLS_DOMAINS="yoowee.ru s3.yoowee.ru s3-console.yoowee.ru"
